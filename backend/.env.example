# This file is OPTIONAL. DLSMirror runs completely locally with no
# configuration at all - if there's no .env file and no ANTHROPIC_API_KEY,
# it automatically starts on its Local Reasoning Engine (deterministic,
# offline, no cost, no key). You do not need to copy or edit this file to
# try DLSMirror locally.
#
# Copy this file to .env only when you want to switch to real Claude
# reasoning. Never commit the real .env file to source control.

# Optional. Leave empty (or don't create .env at all) to use the Local
# Reasoning Engine. Set this to a real key to use real Claude reasoning.
ANTHROPIC_API_KEY=

# Optional - defaults shown
ANTHROPIC_MODEL=claude-sonnet-4-6
PORT=8787
NODE_ENV=development

# Optional. Set to "true" to force the Local Reasoning Engine even if
# ANTHROPIC_API_KEY is set above - useful for free, offline testing without
# temporarily removing a real key.
FORCE_LOCAL=false

# Rate limiting for POST /api/reason
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX=60

# Where the Business Mirror is persisted on disk (one JSON file per business).
# Defaults to backend/data if not set.
DATA_DIR=
